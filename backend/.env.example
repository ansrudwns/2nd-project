# Server Setting
PROJECT_NAME="Real Estate Contract Analysis System"
API_V1_STR="/api/v1"
SECRET_KEY="your-secret-key-here"

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="real_estate_db"
DATABASE_URL="postgresql://postgres:password@localhost:5432/real_estate_db"

# Azure Credentials

# 1. OCR (Document Intelligence)
AZURE_FORM_ENDPOINT="https://<your-resource>.cognitiveservices.azure.com/"
AZURE_FORM_KEY="<your-key>"
AZURE_FORM_API_VERSION="2023-10-31-preview"

# 2. Storage (Blob)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
AZURE_CONTAINER_NAME="contract-analysis"

# 3. RAG (AI Search)
AZURE_SEARCH_ENDPOINT="https://<your-search>.search.windows.net"
AZURE_SEARCH_KEY="<your-key>"
AZURE_SEARCH_INDEX_LAWS="laws-index"
AZURE_SEARCH_INDEX_CASES="cases-index"
AZURE_SEARCH_INDEX_FORMS="forms-index" # 표준 계약서 인덱스

# 4. LLM (Azure OpenAI)
AZURE_OPENAI_API_KEY="<your-key>"
AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2023-05-15"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4"
AZURE_OPENAI_EMBEDDING_MODEL="text-embedding-ada-002"

# 5. Market API (Optional)
MARKET_API_URL="https://api.korearealestate.example.com"
MARKET_API_KEY="<optional-key>"

# 6. Azure Language (PII)
AZURE_LANGUAGE_ENDPOINT="https://<your-resource>.cognitiveservices.azure.com/"
AZURE_LANGUAGE_KEY="<your-key>"
